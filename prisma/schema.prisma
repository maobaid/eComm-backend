// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  STORE_ADMIN
  STAFF
}

model Store {
  id                     String    @id @default(uuid())
  name                   String
  slug                   String    @unique
  subscription_plan      String?
  allow_discount_stacking Boolean  @default(false)
  is_active              Boolean   @default(true)
  created_at             DateTime  @default(now())
  users                  User[]
  customers              Customer[]
  addresses              Address[]
  categories             Category[]
  products               Product[]
  coupons                Coupon[]
  productDiscounts       ProductDiscount[]
  orders                 Order[]
  receipts               OrderReceipt[]
  deliverySetting        DeliverySetting?
  @@index([slug])
}

model User {
  id            String   @id @default(uuid())
  store_id      String?
  name          String
  email         String   @unique
  password_hash String
  role          UserRole
  created_at    DateTime @default(now())
  store         Store?   @relation(fields: [store_id], references: [id], onDelete: SetNull)
  @@index([store_id])
  @@index([email])
}

model Customer {
  id           String    @id @default(uuid())
  store_id     String
  full_name    String
  phone_number String
  email        String?
  created_at   DateTime  @default(now())
  store        Store     @relation(fields: [store_id], references: [id], onDelete: Cascade)
  addresses    Address[]
  orders       Order[]
  @@unique([store_id, phone_number])
  @@index([store_id])
}

model Address {
  id               String   @id @default(uuid())
  store_id         String
  customer_id      String
  label            String
  country          String
  city             String
  state            String
  block            String
  street           String
  avenue           String?
  building_number  String
  apartment_number String?
  is_default       Boolean  @default(false)
  created_at       DateTime @default(now())
  store            Store    @relation(fields: [store_id], references: [id], onDelete: Cascade)
  customer         Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  orders           Order[]
  @@index([store_id])
  @@index([customer_id])
}

model Category {
  id         String    @id @default(uuid())
  store_id   String
  name       String
  slug       String
  parent_id  String?
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  store      Store     @relation(fields: [store_id], references: [id], onDelete: Cascade)
  parent     Category? @relation("CategoryHierarchy", fields: [parent_id], references: [id], onDelete: SetNull)
  children   Category[] @relation("CategoryHierarchy")
  products   Product[]
  productDiscounts ProductDiscount[]
  @@unique([store_id, slug])
  @@index([store_id])
  @@index([parent_id])
}

model Product {
  id          String   @id @default(uuid())
  store_id    String
  category_id String?
  title       String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  image_url   String?
  colors      String[] @default([])
  sizes       String[] @default([])
  stock_quantity Int    @default(0)
  low_stock_threshold Int @default(5)
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  store       Store     @relation(fields: [store_id], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  orderItems  OrderItem[]
  productDiscountItems ProductDiscountItem[]
  @@index([store_id])
  @@index([category_id])
}

enum CouponType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id                   String     @id @default(uuid())
  store_id             String
  code                 String
  type                 CouponType
  value                Decimal     @db.Decimal(12, 2)
  minimum_order_amount Decimal?    @db.Decimal(12, 2)
  expires_at           DateTime
  usage_limit          Int?
  usage_count          Int        @default(0)
  is_active            Boolean    @default(true)
  created_at           DateTime   @default(now())
  store                Store      @relation(fields: [store_id], references: [id], onDelete: Cascade)
  orders               Order[]
  @@unique([store_id, code])
  @@index([store_id])
}

enum ProductDiscountAppliesTo {
  ALL_PRODUCTS
  CATEGORY
  SPECIFIC_PRODUCTS
}

model ProductDiscount {
  id          String                 @id @default(uuid())
  store_id    String
  name        String
  percentage  Decimal                @db.Decimal(5, 2)
  applies_to  ProductDiscountAppliesTo
  category_id String?
  start_date DateTime
  end_date    DateTime
  is_active   Boolean                @default(true)
  created_at  DateTime               @default(now())
  store       Store                  @relation(fields: [store_id], references: [id], onDelete: Cascade)
  category    Category?              @relation(fields: [category_id], references: [id], onDelete: SetNull)
  items       ProductDiscountItem[]
  @@index([store_id])
  @@index([category_id])
}

model ProductDiscountItem {
  id                  String          @id @default(uuid())
  product_discount_id String
  product_id          String
  product_discount    ProductDiscount @relation(fields: [product_discount_id], references: [id], onDelete: Cascade)
  product             Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  @@unique([product_discount_id, product_id])
  @@index([product_discount_id])
  @@index([product_id])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ReceiptWhatsappStatus {
  PENDING
  SENT
  FAILED
}

model Order {
  id                           String      @id @default(uuid())
  store_id                     String
  customer_id                  String
  address_id                   String
  coupon_id                    String?
  total_amount                 Decimal     @db.Decimal(12, 2)
  total_product_discount_amount Decimal    @db.Decimal(12, 2) @default(0)
  total_coupon_discount_amount Decimal     @db.Decimal(12, 2) @default(0)
  status                       OrderStatus @default(PENDING)
  scheduled_delivery           DateTime?
  created_at                   DateTime    @default(now())
  store                        Store       @relation(fields: [store_id], references: [id], onDelete: Cascade)
  customer                     Customer    @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  address                      Address     @relation(fields: [address_id], references: [id], onDelete: Restrict)
  coupon                       Coupon?     @relation(fields: [coupon_id], references: [id], onDelete: SetNull)
  items                        OrderItem[]
  receipts                     OrderReceipt[]
  @@index([store_id])
  @@index([customer_id])
  @@index([store_id, status])
  @@index([store_id, created_at])
}

model OrderItem {
  id                       String   @id @default(uuid())
  order_id                 String
  product_id               String
  quantity                 Int
  unit_price               Decimal  @db.Decimal(12, 2)
  product_discount_applied Decimal  @db.Decimal(12, 2) @default(0)
  order                    Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product                  Product  @relation(fields: [product_id], references: [id], onDelete: Restrict)
  @@index([order_id])
  @@index([product_id])
}

model DeliverySetting {
  id                String   @id @default(uuid())
  store_id          String   @unique
  allow_scheduling  Boolean  @default(false)
  default_message   String?
  default_country   String?
  allowed_countries  String?  // JSON array e.g. ["KW","SA","BH"]; null = use default_country only or all
  created_at        DateTime @default(now())
  store             Store    @relation(fields: [store_id], references: [id], onDelete: Cascade)
}

model OrderReceipt {
  id               String                @id @default(uuid())
  order_id         String
  store_id         String
  file_path        String
  file_name        String
  mime_type        String                @default("application/pdf")
  size_bytes       Int
  whatsapp_phone   String
  whatsapp_status  ReceiptWhatsappStatus @default(PENDING)
  whatsapp_message_id String?
  send_attempts    Int                   @default(0)
  last_error       String?
  sent_at          DateTime?
  created_at       DateTime              @default(now())
  order            Order                 @relation(fields: [order_id], references: [id], onDelete: Cascade)
  store            Store                 @relation(fields: [store_id], references: [id], onDelete: Cascade)
  @@index([order_id, created_at])
  @@index([store_id, created_at])
}
